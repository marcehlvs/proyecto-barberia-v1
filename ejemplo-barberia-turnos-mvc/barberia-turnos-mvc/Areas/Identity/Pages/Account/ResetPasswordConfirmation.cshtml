@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Contraseña restablecida";
}

<div id="account">
    <h1>¡Listo!</h1>
    <p class="text-center">
        Tu contraseña se restableció correctamente. Ya podés ingresar con tu nueva contraseña.
    </p>

    <div class="mt-3 text-center">
        <a asp-page="./Login" asp-route-barberia="@Model.BarberiaSlug">Ir a Ingresar</a>
    </div>
</div>
