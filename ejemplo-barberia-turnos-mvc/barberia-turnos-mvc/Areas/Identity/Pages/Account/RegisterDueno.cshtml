@page
@model RegisterDuenoModel

@{
    ViewData["Title"] = "Registrá tu barbería";
}

<div id="account" style="max-width: 480px;">
    <h1>Registrá tu barbería</h1>
    <p class="text-center mb-3">Creá tu cuenta de dueño y empezá a recibir turnos online.</p>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post">
        <div class="form-floating mb-3">
            <input asp-for="Input.NombreBarberia" id="nombreBarberia" class="form-control" placeholder="Barbería El Corte" />
            <label asp-for="Input.NombreBarberia">Nombre de la barbería</label>
            <span asp-validation-for="Input.NombreBarberia" class="text-danger"></span>
        </div>

        <div class="form-floating mb-1">
            <input asp-for="Input.Slug" id="slug" class="form-control" placeholder="elcorte" autocomplete="off" />
            <label asp-for="Input.Slug">Identificador en la URL</label>
            <span asp-validation-for="Input.Slug" class="text-danger"></span>
        </div>
        <p class="mb-3" style="font-size: 13px; opacity: 0.7;">
            Tu barbería va a estar en: <code>tudominio.com/<span id="previewSlug">tu-slug</span></code>
        </p>

        <div class="form-floating mb-3">
            <input asp-for="Input.Direccion" class="form-control" placeholder="Dirección" />
            <label asp-for="Input.Direccion">Dirección (opcional)</label>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Telefono" class="form-control" placeholder="Teléfono" />
            <label asp-for="Input.Telefono">Teléfono (opcional)</label>
        </div>

        <hr style="opacity:0.2; margin: 24px 0;" />

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nombre@ejemplo.com" />
            <label asp-for="Input.Email">Tu email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Contraseña" />
            <label asp-for="Input.Password">Contraseña</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmar contraseña" />
            <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <hr style="opacity:0.2; margin: 24px 0;" />

        <div class="form-floating mb-3">
            <input asp-for="Input.CodigoInvitacion" type="password" class="form-control" autocomplete="off" placeholder="Código de invitación" />
            <label asp-for="Input.CodigoInvitacion">Código de invitación</label>
            <span asp-validation-for="Input.CodigoInvitacion" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-guardar w-100">Crear mi barbería</button>

        <div class="mt-3 text-center">
            <a asp-page="./Login">¿Ya tenés una cuenta de dueño? Ingresá</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Sugiere el slug a partir del nombre, mientras el dueño no haya
        // tocado el campo de slug a mano todavía.
        const nombreInput = document.getElementById('nombreBarberia');
        const slugInput = document.getElementById('slug');
        const previewSlug = document.getElementById('previewSlug');
        let slugEditadoManualmente = slugInput.value.length > 0;

        function slugify(texto) {
            return texto
                .toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // saca acentos
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
        }

        nombreInput.addEventListener('input', () => {
            if (!slugEditadoManualmente) {
                slugInput.value = slugify(nombreInput.value);
                previewSlug.textContent = slugInput.value || 'tu-slug';
            }
        });

        slugInput.addEventListener('input', () => {
            slugEditadoManualmente = true;
            previewSlug.textContent = slugInput.value || 'tu-slug';
        });
    </script>
}
