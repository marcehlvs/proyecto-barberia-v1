@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Ya casi estamos";
}

<h1>@ViewData["Title"]</h1>
@{
    <div class="alert alert-info">
        <p class="mb-0">
            <strong>¡Registro exitoso!</strong> Solo te falta un paso más.
            Te enviamos un enlace a tu casilla de correo. Por favor, revisá tu bandeja de entrada (y la carpeta de spam por las dudas) y hacé clic en el enlace para confirmar tu cuenta.
        </p>
    </div>
}

