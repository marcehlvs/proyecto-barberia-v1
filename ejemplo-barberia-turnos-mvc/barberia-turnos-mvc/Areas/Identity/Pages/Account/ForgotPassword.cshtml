@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Olvidé mi contraseña";
}

<div id="account">
    <h1>Olvidé mi contraseña</h1>
    <p class="text-center mb-3">Ingresá tu email y te mandamos un link para restablecerla.</p>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post" asp-route-barberia="@Model.BarberiaSlug">
        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nombre@ejemplo.com" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-guardar w-100">Enviar link</button>

        <div class="mt-3 text-center">
            <a asp-page="./Login" asp-route-barberia="@Model.BarberiaSlug">Volver a Ingresar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
