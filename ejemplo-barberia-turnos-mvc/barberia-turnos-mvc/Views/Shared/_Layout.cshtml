@using Microsoft.AspNetCore.Identity
@using barberia_turnos_mvc.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ICurrentBarberiaService CurrentBarberia


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - barberia_turnos_mvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/barberia.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" asp-route-barberiaSlug="@CurrentBarberia.Barberia?.Slug">@(CurrentBarberia.Barberia?.Nombre ?? "Turnos Online")</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between flex-wrap">
                    <ul class="navbar-nav flex-grow-1 flex-wrap">
                        @if (User.IsInRole("Dueño"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Panel</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Turno" asp-action="Index">Turnos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Servicio" asp-action="Index">Servicios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Cliente" asp-action="Index">Clientes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="BloqueoHorario" asp-action="Index">Bloqueos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Barberia" asp-action="Configuracion">Configuración</a></li>
                        }
                        @if (User.IsInRole("Cliente"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="MiCuenta" asp-action="MisTurnos">Mis Turnos</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @await Component.InvokeAsync("FooterInfo")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
