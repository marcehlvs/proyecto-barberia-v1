@model barberia_turnos_mvc.Models.Barberia

<footer class="footer-principal">
    <div class="footer-contenido">
        <div class="footer-col">
            <h5>@(Model?.Nombre ?? "Barbería El Corte")</h5>
            <p>@(Model?.Direccion ?? "")</p>
            <p>@(Model?.Telefono ?? "")</p>
        </div>

        <div class="footer-col">
            <h5>Horarios de atención</h5>
            <p>Martes a Viernes: 10:00 - 20:00</p>
            <p>Sábados: 10:00 - 20:00</p>
        </div>

        <div class="footer-col">
            <h5>Seguinos</h5>
            <div class="footer-redes">
                <a href="#" target="_blank" rel="noopener"><i class="bi bi-instagram"></i> Instagram</a>
                <a href="#" target="_blank" rel="noopener"><i class="bi bi-facebook"></i> Facebook</a>
                <a href="#" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> WhatsApp</a>
            </div>
        </div>

        <div class="footer-col footer-mapa">
            <h5>Cómo llegar</h5>
            <iframe src="https://www.google.com/maps?q=@(Uri.EscapeDataString(Model?.Direccion ?? "Buenos Aires"))&output=embed"
                    width="100%" height="150" style="border:0;" loading="lazy">
            </iframe>
        </div>
    </div>

    <div class="footer-copyright">
        <p>&copy; @DateTime.Now.Year @(Model?.Nombre ?? "Barbería El Corte"). Todos los derechos reservados.</p>
    </div>
</footer>