@using Microsoft.AspNetCore.Identity
@using barberia_turnos_mvc.Models
@inject SignInManager<ApplicationUser> SignInManager
@model barberia_turnos_mvc.Models.Barberia

@{
    ViewData["Title"] = "Inicio";
}

<section class="hero hero-video">
    <video class="hero-video-bg" autoplay muted loop playsinline poster="~/media/hero-interior.jpg">
        <source src="~/media/hero-barberia.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>

    <div class="hero-contenido">
        <h1>@(Model?.Nombre ?? "Barbería")</h1>
        <p class="tagline">Turnos online · Sin vueltas</p>

        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Cliente"))
        {
            <a asp-controller="MiCuenta" asp-action="Reservar" class="btn btn-reservar">Reservar turno</a>
        }
        else if (SignInManager.IsSignedIn(User) && User.IsInRole("Dueño"))
        {
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-reservar">Ver panel</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" asp-route-barberia="@Model?.Slug" class="btn btn-reservar">Reservar turno</a>
        }
    </div>
</section>

<div class="franja"></div>

@if (!string.IsNullOrWhiteSpace(Model?.Descripcion))
{
    <section class="nosotros py-5">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-12 @(Model.Fotos.Any() ? "col-md-6" : "")">
                    <h2>Nosotros</h2>
                    <p class="lead" style="white-space: pre-line;">@Model.Descripcion</p>
                </div>

                @if (Model.Fotos.Any())
                {
                    <div class="col-12 col-md-6">
                        <div id="carruselNosotros" class="carousel slide rounded overflow-hidden shadow-sm" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @for (var i = 0; i < Model.Fotos.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@Model.Fotos[i]" class="d-block w-100" style="height: 320px; object-fit: cover;" alt="Foto de @Model.Nombre">
                                    </div>
                                }
                            </div>

                            @if (Model.Fotos.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#carruselNosotros" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carruselNosotros" data-bs-slide="next">
                                    <span class="carousel-control-next-icon"></span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="franja"></div>
}

<section class="servicios">
    <h2>Servicios</h2>

    @if (Model?.Servicios != null && Model.Servicios.Any())
    {
        <ul class="lista-precios">
            @foreach (var servicio in Model.Servicios)
            {
                <li>
                    <span class="nombre-servicio">
                        @servicio.Nombre
                        <span class="duracion">@servicio.DuracionMinutos min</span>
                    </span>
                    <span class="relleno"></span>
                    <span class="precio">$@servicio.Precio.ToString("N0")</span>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-center">Todavía no hay servicios cargados.</p>
    }
</section>