@model barberia_turnos_mvc.Models.BloqueoHorario

@{
    ViewData["Title"] = "Eliminar Bloqueo de Horario";
}

<h1>Eliminar Bloqueo de Horario</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<div class="caja-eliminar">
    <p>¿Estás seguro que querés eliminar este bloqueo de horario?</p>

    <dl class="row detalle-info">
        <dt class="col-sm-3">Desde</dt>
        <dd class="col-sm-9">@Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Hasta</dt>
        <dd class="col-sm-9">@Model.FechaFin.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Motivo</dt>
        <dd class="col-sm-9">@(Model.Motivo ?? "-")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-confirmar-eliminar">Eliminar</button>
        <a asp-action="Index" class="btn-cancelar">Cancelar</a>
    </form>
</div>