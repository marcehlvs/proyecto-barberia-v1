@model barberia_turnos_mvc.Models.EstadisticasViewModel

@{
    ViewData["Title"] = "Estadísticas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Estadísticas</h1>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver al panel
    </a>
</div>

<p class="text-muted">Últimos 6 meses</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">@Model.TotalTurnosUltimos6Meses</div>
                <div class="text-muted small">Turnos totales</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 border-success">
            <div class="card-body">
                <div class="fs-3 fw-bold text-success">$@Model.IngresosUltimos6Meses.ToString("N0")</div>
                <div class="text-muted small">Ingresos por señas</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">@(Model.TopServicios.FirstOrDefault()?.Nombre ?? "—")</div>
                <div class="text-muted small">Servicio más pedido</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100 @(Model.TasaNoShow is > 15 ? "border-danger" : "")">
            <div class="card-body">
                <div class="fs-3 fw-bold @(Model.TasaNoShow is > 15 ? "text-danger" : "")">
                    @(Model.TasaNoShow.HasValue ? $"{Model.TasaNoShow}%" : "—")
                </div>
                <div class="text-muted small">Tasa de no-show</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header">Ingresos por mes</div>
            <div class="card-body">
                <canvas id="graficoIngresos" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header">Turnos por mes</div>
            <div class="card-body">
                <canvas id="graficoTurnos" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Servicios más pedidos</div>
    @if (!Model.TopServicios.Any())
    {
        <div class="card-body">
            <p class="text-muted mb-0">Todavía no hay turnos en este período.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th class="text-end">Turnos</th>
                        <th class="text-end">Ingresos por seña</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var servicio in Model.TopServicios)
                    {
                        <tr>
                            <td>@servicio.Nombre</td>
                            <td class="text-end">@servicio.Cantidad</td>
                            <td class="text-end">$@servicio.IngresoTotal.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const meses = @Html.Raw(Json.Serialize(Model.MesesLabels));
        const ingresos = @Html.Raw(Json.Serialize(Model.IngresosPorMes));
        const turnos = @Html.Raw(Json.Serialize(Model.TurnosPorMes));

        new Chart(document.getElementById('graficoIngresos'), {
            type: 'line',
            data: {
                labels: meses,
                datasets: [{
                    label: 'Ingresos por seña ($)',
                    data: ingresos,
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.15)',
                    fill: true,
                    tension: 0.25
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        new Chart(document.getElementById('graficoTurnos'), {
            type: 'bar',
            data: {
                labels: meses,
                datasets: [{
                    label: 'Turnos',
                    data: turnos,
                    backgroundColor: '#0d6efd'
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
