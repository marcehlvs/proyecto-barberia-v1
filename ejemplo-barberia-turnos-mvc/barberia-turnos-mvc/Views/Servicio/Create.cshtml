@model barberia_turnos_mvc.Models.Servicio

@{
    ViewData["Title"] = "Nuevo Servicio";
}

<h1>Nuevo Servicio</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DuracionMinutos"></label>
        <input asp-for="DuracionMinutos" class="form-control" />
        <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-crear">Crear</button>
</form>

<a asp-action="Index">Volver al listado</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}