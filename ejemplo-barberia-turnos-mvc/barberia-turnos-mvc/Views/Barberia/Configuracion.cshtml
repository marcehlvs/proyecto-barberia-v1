@model barberia_turnos_mvc.Models.Barberia

@{
    ViewData["Title"] = "Configuración";
}

<h1>Configuración de la Barbería</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Configuracion">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Direccion"></label>
        <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Telefono"></label>
        <input asp-for="Telefono" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PorcentajeSeña">Porcentaje de seña (%)</label>
        <input asp-for="PorcentajeSeña" class="form-control" type="number" step="1" min="0" max="100" />
        <span asp-validation-for="PorcentajeSeña" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="MinutosEntreTurnos">Colchón entre turnos (minutos)</label>
        <input asp-for="MinutosEntreTurnos" class="form-control" type="number" step="1" min="0" max="60" />
        <span asp-validation-for="MinutosEntreTurnos" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="HoraApertura">Hora de apertura</label>
        <input asp-for="HoraApertura" asp-format="{0:hh\:mm}" class="form-control" type="time" />
        <span asp-validation-for="HoraApertura" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="HoraCierre">Hora de cierre</label>
        <input asp-for="HoraCierre" asp-format="{0:hh\:mm}" class="form-control" type="time" />
        <span asp-validation-for="HoraCierre" class="text-danger"></span>
    </div>




    <button type="submit" class="btn-guardar">Guardar</button>
</form>

<hr />

<h2>Mercado Pago</h2>

@if (TempData["MpConnectOk"] != null)
{
    <div class="alert alert-success">@TempData["MpConnectOk"]</div>
}
@if (TempData["MpConnectError"] != null)
{
    <div class="alert alert-danger">@TempData["MpConnectError"]</div>
}

@if (Model.TieneMercadoPagoConectado)
{
    <p>
        ✅ Tu cuenta de Mercado Pago está conectada.
        Las señas de tus turnos se cobran directamente en tu cuenta.
    </p>

    <form asp-controller="MercadoPagoConnect" asp-action="Desconectar" method="post"
          onsubmit="return confirm('¿Seguro que querés desconectar tu cuenta de Mercado Pago? Mientras no vuelvas a conectarla, no vas a poder cobrar señas.');">
        <button type="submit" class="btn-eliminar">Desconectar cuenta de Mercado Pago</button>
    </form>
}
else
{
    <p>
        ⚠️ Todavía no conectaste tu cuenta de Mercado Pago.
        Sin esto, tus clientes no van a poder pagar la seña al reservar un turno.
    </p>

    <a asp-controller="MercadoPagoConnect" asp-action="Conectar" class="btn-guardar">
        Conectar con Mercado Pago
    </a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
