@model barberia_turnos_mvc.Models.Barberia

@{
    ViewData["Title"] = "Configuración";
}

<h1>Configuración de la Barbería</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Configuracion">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Direccion"></label>
        <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Telefono"></label>
        <input asp-for="Telefono" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PorcentajeSeña">Porcentaje de seña (%)</label>
        <input asp-for="PorcentajeSeña" class="form-control" type="number" step="1" min="0" max="100" />
        <span asp-validation-for="PorcentajeSeña" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-guardar">Guardar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}